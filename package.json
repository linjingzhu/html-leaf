{
  "name": "leaf",
  "version": "0.5.14",
  "private": true,
  "description": "Leaf visual document editor with project workspaces, source-fidelity guards, structured HTML editing, and HTML/Markdown/PDF document support.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "qa": "node scripts/qa-v0514.js",
    "qa:fidelity": "node scripts/qa-source-fidelity.js",
    "icons:build": "python scripts/build-icons.py build/icon.png .",
    "dist:win": "electron-builder --win nsis zip --x64 --publish never"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.leaf.editor",
    "productName": "Leaf",
    "asar": true,
    "directories": {
      "output": "release-v0.5.14",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.ico",
      "build/icon.png",
      "README.md",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Leaf-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Leaf",
      "installerIcon": "build/installerIcon.ico",
      "installerHeaderIcon": "build/installerHeaderIcon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Leaf-Setup-${version}-${arch}.${ext}"
    }
  }
}

{
  "name": "leaf",
  "version": "0.6.0",
  "private": true,
  "description": "Leaf visual project editor with document workspaces, source-fidelity guards, and HTML/Markdown/JSON/PDF page support.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "postinstall": "node scripts/check-single-napi-canvas.cjs",
    "source:cleanup": "node scripts/apply-roadmap-source-cleanup.js",
    "qa": "node scripts/qa-v0516.js",
    "qa:github-client": "node scripts/qa-github-client.js",
    "qa:google-drive": "node scripts/qa-google-drive.js",
    "qa:static": "node scripts/qa-static.js",
    "qa:startup-adversarial": "node scripts/qa-startup-adversarial.js",
    "qa:startup-readiness": "node scripts/qa-startup-readiness-guard.js",
    "qa:fidelity": "node scripts/qa-source-fidelity.js",
    "qa:scripted-html-edit": "node scripts/qa-scripted-html-edit-v0516.js && node scripts/qa-scripted-html-dom-edit-regression.js",
    "qa:release-version": "node scripts/qa-release-version-v0516.js",
    "qa:zoom-scrollbar": "node scripts/qa-zoom-scrollbar-v0516.js",
    "qa:theme-light": "node scripts/qa-theme-light-v0516.js",
    "version:build": "node scripts/bump-build-version.js",
    "icons:build": "python scripts/build-icons.py build/icon.png .",
    "dist:win": "npm run version:build && electron-builder --win nsis zip --x64 --publish=never",
    "dist:mac": "node scripts/build-macos-sequential.js",
    "dist:mac:arm64": "npm run version:build && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac:x64": "npm run version:build && electron-builder --mac dmg zip --x64 --publish never"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.624",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "overrides": {
    "@napi-rs/canvas": "$@napi-rs/canvas"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.leaf.editor",
    "productName": "Leaf",
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/@napi-rs/canvas*/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs",
      "node_modules/pdfjs-dist/cmaps/**",
      "node_modules/pdfjs-dist/standard_fonts/**",
      "resources/ocr/**"
    ],
    "directories": {
      "output": "release-v0.6.0",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "resources/**/*",
      "build/icon.ico",
      "build/icon.png",
      "build/icon.icns",
      "README.md",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Leaf-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Leaf",
      "installerIcon": "build/installerIcon.ico",
      "installerHeaderIcon": "build/installerHeaderIcon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Leaf-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Leaf-${version}-mac-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "identity": null,
      "extendInfo": {
        "NSHumanReadableCopyright": "Leaf",
        "LSMinimumSystemVersion": "11.0"
      }
    },
    "dmg": {
      "artifactName": "Leaf-${version}-mac-${arch}.${ext}",
      "title": "Leaf ${version}"
    }
  }
}
